# Copy this file to .env.local and fill in your Supabase project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# To provision the super admin you need the service role key ONCE:
#  1. Sign up normally (an owner account + 14-day trial is created automatically).
#  2. In the Supabase SQL editor (using the service role):
#       insert into public.super_admins (user_id) values ('<the signup user id>');
VITE_SUPABASE_SERVICE_KEY=DO_NOT_COMMIT

# ----------------------------------------------------------------------------
# bulkSMSBD SMS dispatch (serverless function /api/dispatch-sms)
# ----------------------------------------------------------------------------
# These are read by the Vercel function only (never shipped to the browser).
# Configure them in the Vercel project → Settings → Environment Variables.
#
#   VITE_SUPABASE_URL        the same value as above
#   SUPABASE_SERVICE_ROLE_KEY  from Supabase Dashboard → Settings → API
#   BULKSMSBD_API_KEY        your bulkSMSBD account API key
#   BULKSMSBD_SENDER_ID      your approved bulkSMSBD sender ID (e.g. 8809648906525)
#
# The Vercel cron (every 5 min) calls /api/dispatch-sms automatically.
# You can also press "Dispatch now" in the Messaging page to trigger it manually.
